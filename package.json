{
  "name": "node-red-contrib-yandex-commander",
  "version": "0.2.0",
  "description": "Manage Yandex Stations in Node-RED via WebSockets (local Glagol protocol + QR/OAuth)",
  "type": "commonjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --prod",
    "build:watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gberikov/node-red-contrib-yandex-commander.git"
  },
  "bugs": {
    "url": "https://github.com/gberikov/node-red-contrib-yandex-commander/issues"
  },
  "homepage": "https://github.com/gberikov/node-red-contrib-yandex-commander#readme",
  "author": "gberikov",
  "license": "ISC",
  "engines": {
    "node": ">=18.5"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "yandex-commander-connect": "build/nodes/connect/connect.js",
      "yandex-commander-station": "build/nodes/station/station.js",
      "yandex-commander-get": "build/nodes/get/get.js",
      "yandex-commander-in": "build/nodes/in/in.js",
      "yandex-commander-out": "build/nodes/out/out.js"
    }
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "yandex",
    "alice",
    "station",
    "commander",
    "quasar",
    "smart-home"
  ],
  "dependencies": {
    "axios": "^1.16.1",
    "node-dns-sd": "^1.0.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.9.0",
    "@types/node-red": "^1.3.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "node-red": "^4.1.10",
    "node-red-node-test-helper": "^0.3.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
