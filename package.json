{
  "name": "node-red-contrib-yandex-commander",
  "version": "0.1.0",
  "description": "Manage Yandex Stations in Node RED via Websockets",
  "scripts": {
    "build": "pnpm run build:editor && pnpm run build:runtime && pnpm run build:copy",
    "build:editor": "rollup --config rollup.config.mjs",
    "build:runtime": "tsc",
    "build:copy": "node -e \"const fs=require('fs');const p=require('path');function cpR(s,d){if(!fs.existsSync(s))return;if(fs.statSync(s).isDirectory()){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>cpR(p.join(s,f),p.join(d,f)))}else{fs.mkdirSync(p.dirname(d),{recursive:true});try{fs.unlinkSync(d)}catch(e){}fs.copyFileSync(s,d)}}cpR('nodes/icons','build/nodes/icons');cpR('src/nodes/out/locales','build/nodes/out/locales')\"",
    "test": "echo \"no test specified\"",
    "lint": "eslint . --ext .ts,.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gberikov/node-red-contrib-yandex-commander"
  },
  "author": "n0name",
  "license": "ISC",
  "homepage": "https://github.com/gberikov/node-red-contrib-yandex-commander.git",
  "node-red": {
    "nodes": {
      "yandex-commander-connect": "build/nodes/connect/connect.js",
      "yandex-commander-station": "build/nodes/station/station.js",
      "yandex-commander-get": "build/nodes/get/get.js",
      "yandex-commander-in": "build/nodes/in/in.js",
      "yandex-commander-out": "build/nodes/out/out.js"
    }
  },
  "keywords": [
    "node-red",
    "yandex",
    "alice",
    "station",
    "commander"
  ],
  "dependencies": {
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "node-dns-sd": "^1.0.1",
    "ws": "^7.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "@types/node-red": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "fast-glob": "^3.3.3",
    "glob": "^11.0.0",
    "node-red": "^4.0.5",
    "prettier": "^3.4.2",
    "rollup": "^4.28.1",
    "rollup-plugin-delete": "^2.1.0",
    "typescript": "^5.7.2"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/no-unused-vars": "warn",
      "@typescript-eslint/explicit-function-return-type": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 200,
    "tabWidth": 2,
    "trailingComma": "none"
  }
}
