{
  "name": "node-red-contrib-yandex-commander",
  "version": "0.1.0",
  "description": "Manage Yandex Stations in Node RED via Websockets",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "test": "echo \"no test specified\"",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gberikov/node-red-contrib-yandex-commander"
  },
  "author": "gberikov",
  "license": "ISC",
  "homepage": "https://github.com/gberikov/node-red-contrib-yandex-commander.git",
  "node-red": {
    "nodes": {
      "yandex-commander-connect": "build/nodes/connect/connect.js",
      "yandex-commander-station": "build/nodes/station/station.js",
      "yandex-commander-get": "build/nodes/get/get.js",
      "yandex-commander-in": "build/nodes/in/in.js",
      "yandex-commander-out": "build/nodes/out/out.js"
    }
  },
  "keywords": [
    "node-red",
    "yandex",
    "alice",
    "station",
    "commander"
  ],
  "dependencies": {
    "axios": "^1.13.6",
    "node-dns-sd": "^1.0.1",
    "ws": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.3",
    "@types/node-red": "^1.3.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "node-red": "^4.1.6",
    "typescript": "^5.9.3"
  }
}
